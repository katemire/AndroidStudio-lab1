<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lab 1"
            android:textColor="#17233C"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Variant 16: Five Longest Words"
            android:textColor="#596780"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Input text"
            android:textColor="#17233C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#345995"
            android:gravity="top|start"
            android:hint="Enter or edit text"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:text="Functional programming helps separate data processing and application interface. Algorithms should be clear, testable and reusable. Kotlin provides convenient tools for working with collections and text."
            android:textColor="#17233C"
            android:textSize="16sp" />

        <Button
            android:id="@+id/processButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Find 5 Longest Words"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Result"
            android:textColor="#17233C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:minHeight="100dp"
            android:padding="16dp"
            android:text="Press the button to process the text."
            android:textColor="#17233C"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
