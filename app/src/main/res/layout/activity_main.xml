<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Лабораторная работа № 1"
            android:textColor="#17233C"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Вариант 16 · Пять самых длинных слов"
            android:textColor="#596780"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Исходный текст"
            android:textColor="#17233C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#345995"
            android:gravity="top|start"
            android:hint="Введите или измените текст"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:text="Функциональное программирование помогает разделять обработку данных и интерфейс приложения. Алгоритмы должны быть понятными, проверяемыми и повторно используемыми. Kotlin предоставляет удобные средства для работы с коллекциями и текстом."
            android:textColor="#17233C"
            android:textSize="16sp" />

        <Button
            android:id="@+id/processButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Найти 5 самых длинных слов"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Результат"
            android:textColor="#17233C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:minHeight="100dp"
            android:padding="16dp"
            android:text="Нажмите кнопку, чтобы обработать текст."
            android:textColor="#17233C"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
